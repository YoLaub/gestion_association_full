generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profil {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  firstName     String?
  lastName      String?
  email         String    @unique
  birthday      DateTime?
  phone         String?
  isActive      Boolean   @default(true)
  setInactiveAt DateTime?
  avatarUrl     String?
  createdAt     DateTime  @default(now())

  roles             Role[]             @relation("ProfilRoles")
  infoAdherent      InfoAdherent?
  emergencyContacts EmergencyContact[] @relation("ProfilEmergencyContacts")
  addresses         Address[]          @relation("ProfilAddresses")
  activity          ActivityProfil[]
  createdActivities Activity[]         @relation("ActivityCreatedBy")
  tasks             Tasks[]            @relation("ProfilTasks")
}

model Role {
  id       String   @id @default(cuid())
  roleName String   @unique
  profils  Profil[] @relation("ProfilRoles")
}

model InfoAdherent {
  id                String    @id @default(cuid())
  medicalCertifDate DateTime?
  licenseNumber     String?   @unique
  licenseValidate   Boolean   @default(false)

  profilId String @unique
  profil   Profil @relation(fields: [profilId], references: [id], onDelete: Cascade)
}

model EmergencyContact {
  id                    String @id @default(cuid())
  emergencyContactName  String
  emergencyContactPhone String

  profils Profil[] @relation("ProfilEmergencyContacts")
}

model Address {
  id         String  @id @default(cuid())
  label      String?
  street     String?
  postalCode String?
  country    String?
  city       String?

  profils Profil[] @relation("ProfilAddresses")
}

model Activity {
  id          String    @id @default(cuid())
  title       String
  description String?
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  startTime   DateTime? @db.Time
  endTime     DateTime? @db.Time
  wholeDay    Boolean?
  place       String?
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  idResources String?
  createdById String
  eventTypeId String?

  profils   ActivityProfil[]
  createdBy Profil           @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  eventType EventType?       @relation(fields: [eventTypeId], references: [id])
  location  Location[]       @relation("ActivityLocation")
  course    course?
  event     Event?
}

model ActivityProfil {
  activityId String
  profilId   String
  status     String
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id])
  profil   Profil   @relation(fields: [profilId], references: [id])

  @@id([activityId, profilId])
}

model EventType {
  id        String @id @default(cuid())
  label     String
  colorCode String

  activities Activity[]
}

model Location {
  id            String  @id @default(cuid())
  name          String
  address       String
  googleMapLink String?

  activity Activity[] @relation("ActivityLocation")
}

model course {
  id         String  @id @default(cuid())
  level      String
  comment    String? @db.Text
  activityId String  @unique

  activity Activity @relation(fields: [activityId], references: [id])
}

model Event {
  id         String  @id @default(cuid())
  capacity   Int?
  visibility Boolean
  activityId String  @unique

  activity Activity @relation(fields: [activityId], references: [id])
  board    Board?
}

model Task {
  id          String    @id @default(cuid())
  title       String
  startDate   DateTime?
  endDate     DateTime?
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  description String?
  comment     String?   @db.Text
  position    Int
  columnId    String

  profils Profil[] @relation("ProfilTasks")
  column Column   @relation(fields: [columnId], references: [id])

  @@unique([columnId, position])
  @@index([columnId])
}

model Board {
  id      String @id @default(cuid())
  title   String
  eventId String @unique

  event   Event    @relation(fields: [eventId], references: [id])
  columns Column[]
}

model Column {
  id       String @id @default(cuid())
  title    String
  position Int
  boardId  String

  board Board   @relation(fields: [boardId], references: [id])
  tasks Task[]

  @@unique([boardId, position])
  @@index([boardId])
}
